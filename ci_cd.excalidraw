      "updated": 1756405250109,
      "link": null,
      "locked": false,
      "text": "Git tags are references that point to specific commits in your repository history. \nUnlike branches, tags are immutable - once created, they don't move. \nThey're commonly used to mark release points (v1.0, v2.1, etc.).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Git tags are references that point to specific commits in your repository history. \nUnlike branches, tags are immutable - once created, they don't move. \nThey're commonly used to mark release points (v1.0, v2.1, etc.).",
      "autoResize": true,
      "lineHeight": 1.25
    }
